# ============================================================
# Проєкт «МійДім ОСББ» — Конфігурація середовища
# ============================================================

# Додаток
APP_NAME="МійДім ОСББ"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_SECRET=osbb_secret_key_change_me_in_production_min_32_chars

# Підключення до бази даних MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=osbb_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Реквізити ОСББ для генерації квитанцій та QR-кодів НБУ
OSBB_NAME="ОСББ Затишний Дім"
OSBB_EDRPOU="38947211"
OSBB_IBAN="UA213223130000026007233566123"
OSBB_BANK="АТ Укрексімбанк"
OSBB_PHONE="+38 (050) 111-22-33"
OSBB_EMAIL="info@mydom.ua"
OSBB_ADDRESS="м. Київ, вул. Героїв Дніпра, 42"

# Налаштування Telegram Bot
# Отримайте токен бота в @BotFather
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"
TELEGRAM_BOT_USERNAME="MyDomOsbbBot"
# Публічний URL для Webhook (на продакшн-сервері з HTTPS)
TELEGRAM_WEBHOOK_URL="https://your-domain.ua/bot-webhook.php"
